10 REM COLOR_T - standalone color plane test (V1.3)
20 REM COLOR sticky across CLS; NEW restores green FG=1 BG=0.
30 CLS
40 PRINT "COLOR TEST"
50 COLOR 4,0:SET(30,20)
60 PRINT "CA=";COLORAT(30,20);" P=";POINT(30,20);" expect 4 -1"
70 COLOR 1,0:SET(40,20,7):SET(41,20,2)
80 PRINT COLORAT(40,20);COLORAT(41,20);POINT(40,20);" expect 7 2 -1"
90 COLOR 5,0:SET(50,20):RESET(50,20)
100 PRINT COLORAT(50,20);POINT(50,20);" expect 0 0"
110 COLOR 8,0
120 PRINT "THIS LINE IS WHITE"
130 INPUT "ENTER=CLS keeps white";Z$
140 CLS
150 PRINT "STILL WHITE AFTER CLS"
160 PRINT "DONE: NEW then green; LOAD COLOR_T to repeat"
170 END
