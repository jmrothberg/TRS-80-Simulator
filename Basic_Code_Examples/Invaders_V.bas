10 REM JMR'S BASIC SPACE INVADERS AUG 20 2024
20 REM RUNS ON TRS-80 MODEL 1 SIMULATOR
30 CLS
40 PRINT "       *** SPACE INVADERS ***"
50 PRINT
60 PRINT "  DESTROY THE ALIEN WAVE."
70 PRINT "  HIDE BEHIND THE BUNKERS."
80 PRINT
90 PRINT "  A   = MOVE LEFT"
100 PRINT "  S   = MOVE RIGHT"
110 PRINT "  SPC = FIRE"
120 PRINT
130 PRINT "  YOU HAVE 3 LIVES.  SCORE POINTS"
140 PRINT "  FOR EACH INVADER DESTROYED."
150 PRINT
160 PRINT "  PRESS ANY KEY TO START"
170 IF INKEY$="" THEN 170
180 REM INITIALIZE VARIABLES
190 LET S = 120
200 DIM B(5)  : REM ARRAY FOR 5 BULLETS
205 DIM EB(5) : REM ARRAY FOR 5 ENEMY BULLETS
210 DIM E(15)
215 DIM BK(60) : REM ARRAY FOR 4 BUNKERS WITH 15 PIXELS EACH
220 LET D = 1
230 LET SC = 0
240 LET LV = 3
245 REM SP = FRAME DELAY — RAISE IF TOO FAST ON FPGA (0 = max speed)
250 LET SP = 0
260 LET F = 2 : REM HOW FAST PLAYER PLAYS
270 LET L = 1 : REM HOW FAST BULLETS MOVES
275 LET OC = -1 : LET OL = -1 : REM FORCE FIRST SCORE PRINT
276 FOR I = 1 TO 5: LET B(I) = 0: LET EB(I) = 0: NEXT I
280 REM INITIALIZE ENEMIES (Y starts at 6 so SCORE text row stays clear)
290 FOR I = 1 TO 15
300 LET R = INT((I-1)/ 5)
310 LET C = I - 1 - (R * 5)
320 LET E(I) = R * 1024 + (C * 24) + 1 + 768 : REM +6 pixel rows
330 NEXT I
340 REM INITIALIZE BUNKERS
350 FOR I = 1 TO 60
360 LET BK(I) = 1
370 NEXT I
372 CLS
373 GOSUB 1800 : REM BUNKERS ONCE (not every frame)
374 GOSUB 1000 : REM INITIAL SPRITE + SCORE DRAW
380 REM MAIN GAME LOOP — erase, move, draw, then hits (draw before slow collisions)
385 GOSUB 900 : REM ERASE MOVERS
400 GOSUB 2000 : REM CHECK INPUTS
410 GOSUB 3000
415 GOSUB 1000 : REM DRAW before hits so glass stays filled during bunker scan
420 GOSUB 4000
430 IF SP > 0 THEN FOR I = 1 TO SP: NEXT I
450 GOTO 380
900 REM ERASE MOVERS AT CURRENT COORDS
910 FOR I = 1 TO 15
920 IF E(I) > 0 THEN GOSUB 1400
930 NEXT I
940 GOSUB 1450 : REM ERASE GUN
950 FOR I = 1 TO 5
960 IF B(I) > 0 THEN GOSUB 1470
970 NEXT I
980 FOR I = 1 TO 5
990 IF EB(I) > 0 THEN GOSUB 1485
995 NEXT I
998 RETURN
1000 REM DRAW MOVERS (no CLS; bunkers already on glass)
1010 IF SC <> OC OR LV <> OL THEN PRINT@0, "SCORE:"; SC; " LIVES:"; LV;: LET OC = SC: LET OL = LV
1030 FOR I = 1 TO 15
1040 IF E(I) > 0 THEN GOSUB 1500 : REM DRAW ENEMIES
1050 NEXT I
1060 GOSUB 1660 : REM DRAW GUN
1070 FOR I = 1 TO 5  : REM DRAW ALL ACTIVE BULLETS
1080 IF B(I) > 0 THEN GOSUB 1700 : REM DRAW PLAYER BULLET
1090 NEXT I
1095 FOR I = 1 TO 5  : REM DRAW ALL ACTIVE ENEMY BULLETS
1096 IF EB(I) > 0 THEN GOSUB 1750 : REM DRAW ENEMY BULLETS
1097 NEXT I
1100 RETURN
1400 REM ERASE SPACE INVADER (mirror 1500 with RESET)
1410 LET X = E(I) - 128 * INT(E(I) / 128)
1420 LET Y = INT(E(I) / 128)
1425 IF X < 0 OR X > 122 OR Y < 0 OR Y > 42 THEN RETURN : REM X+5 must stay <=127 (RTL SET has no clip)
1430 RESET(X+1,Y): RESET(X+4,Y)
1432 RESET(X+2,Y+1): RESET(X+3,Y+1)
1434 RESET(X,Y+2): RESET(X+1,Y+2): RESET(X+2,Y+2): RESET(X+3,Y+2): RESET(X+4,Y+2): RESET(X+5,Y+2)
1436 RESET(X,Y+3): RESET(X+1,Y+3): RESET(X+2,Y+3): RESET(X+3,Y+3): RESET(X+4,Y+3): RESET(X+5,Y+3)
1438 RESET(X,Y+3): RESET(X+2,Y+4): RESET(X+3,Y+4): RESET(X+5,Y+4)
1440 RESET(X+1,Y+5): RESET(X+4,Y+5)
1445 RETURN
1450 REM ERASE GUN
1452 RESET(S, 47): RESET(S-1, 47): RESET(S+1, 47): RESET(S, 46)
1455 RETURN
1470 REM ERASE SINGLE PLAYER BULLET
1472 LET BX = B(I) - 128 * INT(B(I) / 128)
1474 LET BY = INT(B(I) / 128)
1475 IF BX < 0 OR BX > 127 OR BY < 0 OR BY > 47 THEN RETURN
1476 RESET(BX, BY)
1480 RETURN
1485 REM ERASE SINGLE ENEMY BULLET
1486 LET EBX = EB(I) - 128 * INT(EB(I) / 128)
1488 LET EBY = INT(EB(I) / 128)
1489 IF EBX < 0 OR EBX > 127 OR EBY < 0 OR EBY > 47 THEN RETURN
1490 RESET(EBX, EBY)
1495 RETURN
1500 REM DRAW SPACE INVADER ENEMY
1510 LET X = E(I) - 128 * INT(E(I) / 128) : REM MOD 128 (Level II has no MOD)
1520 LET Y = INT(E(I) / 128)
1525 IF X < 0 OR X > 122 OR Y < 0 OR Y > 42 THEN RETURN : REM avoid SET past 127 → left-edge VRAM wrap
1530 REM TOP ROW
1540 SET(X+1,Y): SET(X+4,Y)
1550 REM SECOND ROW
1560 SET(X+2,Y+1): SET(X+3,Y+1)
1570 REM THIRD ROW
1580 SET(X,Y+2): SET(X+1,Y+2): SET(X+2,Y+2): SET(X+3,Y+2): SET(X+4,Y+2): SET(X+5,Y+2)
1590 REM FOURTH ROW
1600 SET(X,Y+3): SET(X+1,Y+3): SET(X+2,Y+3): SET(X+3,Y+3): SET(X+4,Y+3): SET(X+5,Y+3)
1610 REM FIFTH ROW
1620 SET(X,Y+3): SET(X+2,Y+4): SET(X+3,Y+4): SET(X+5,Y+4)
1630 REM BOTTOM ROW
1640 SET(X+1,Y+5): SET(X+4,Y+5)
1650 RETURN
1660 REM DRAW GUN (was 1600-1650: those numbers already belong to the enemy)
1665 SET(S, 47) : REM WAS 48: ROWS ARE 0-47 HERE, NOT 1-48
1670 SET(S-1, 47)
1675 SET(S+1, 47)
1680 SET(S, 46)
1690 RETURN
1700 REM DRAW SINGLE BULLET
1710 LET BX = B(I) - 128 * INT(B(I) / 128)
1720 LET BY = INT(B(I) / 128)
1725 IF BX < 0 OR BX > 127 OR BY < 0 OR BY > 47 THEN RETURN
1730 SET(BX, BY)
1740 RETURN
1750 REM DRAW SINGLE ENEMY BULLET
1760 LET EBX = EB(I) - 128 * INT(EB(I) / 128)
1770 LET EBY = INT(EB(I) / 128)
1775 IF EBX < 0 OR EBX > 127 OR EBY < 0 OR EBY > 47 THEN RETURN
1780 SET(EBX, EBY)
1790 RETURN
1800 REM DRAW BUNKERS (FOR uses P/Q — never I/J: 7000 GOSUBs here while hit-check FOR I/J live)
1810 FOR P = 1 TO 4
1820 FOR Q = 1 TO 5
1830 IF BK((P-1)*15+Q) = 1 THEN SET(Q+28+(P-1)*24, 44) : REM ROWS 44-42, EACH ONE UP
1840 NEXT Q
1850 FOR Q = 6 TO 10
1860 IF BK((P-1)*15+Q) = 1 THEN SET(Q+23+(P-1)*24, 43)
1870 NEXT Q
1880 FOR Q = 11 TO 15
1890 IF BK((P-1)*15+Q) = 1 THEN SET(Q+18+(P-1)*24, 42)
1900 NEXT Q
1910 NEXT P
1920 RETURN
2000 REM CHECK INPUT
2010 LET K = PEEK(14400)
2015 REM PRINT@100, "KEY IS",K
2020 IF K = 65 THEN GOSUB 2100
2030 IF K = 83 THEN GOSUB 2200
2040 IF K = 32 THEN GOSUB 2300
2050 RETURN
2100 REM MOVE LEFT
2110 IF S > 2 THEN LET S = S - F : REM S-1 IS DRAWN, SO S MUST STAY >= 1
2120 RETURN
2200 REM MOVE RIGHT
2210 IF S < 126 THEN LET S = S + F
2220 RETURN
2300 REM FIRE BULLET
2310 FOR I = 1 TO 5  : REM FIND FIRST AVAILABLE BULLET SLOT
2320 IF B(I) = 0 THEN LET B(I) = S + 45 * 128 
2325 IF B(I) = S + 45 * 128 THEN RETURN
2330 NEXT I
2340 RETURN
3000 REM UPDATE GAME STATE
3010 FOR I = 1 TO 5  : REM UPDATE PLAYER BULLETS
3020 IF B(I) > 0 THEN LET B(I) = B(I) - 128 * L
3030 IF B(I) < 0 THEN LET B(I) = 0
3040 NEXT I
3050 FOR I = 1 TO 15
3060 IF E(I) > 0 THEN GOSUB 3100 : REM move or bounce — never wrap X past 0..122
3080 NEXT I
3085 FOR I = 1 TO 5  : REM UPDATE ALL ENEMY BULLETS
3086 IF EB(I) > 0 THEN LET EB(I) = EB(I) + 128 * L
3087 IF EB(I) > 6143 THEN LET EB(I) = 0 : REM 6143 = ROW 47, THE LAST ROW
3088 NEXT I
3090 GOSUB 3300 : REM ENEMY SHOOTS
3095 RETURN
3100 REM MOVE ONE ENEMY: bounce BEFORE step if next X would leave 0..122
3105 REM (old move-then-test wrapped X=0,D=-1 → X=127; SET(X+5) wrote next row col0 = left-edge junk)
3108 LET EX = E(I) - 128 * INT(E(I) / 128)
3109 IF EX > 122 THEN LET E(I) = INT(E(I) / 128) * 128 + 122: LET EX = 122 : REM heal prior wrap
3110 IF (D < 0 AND EX <= 0) OR (D > 0 AND EX >= 122) THEN GOSUB 3200: RETURN
3111 LET E(I) = E(I) + D
3120 RETURN
3200 REM REVERSE DIRECTION AND MOVE DOWN
3210 LET D = -D
3220 GOSUB 3500
3230 RETURN
3300 REM ENEMY SHOOTS
3310 IF RND(0) > 0.95 THEN GOTO 3320 ELSE RETURN : REM LEVEL II RND NEEDS AN ARGUMENT
3320 LET R = RND(15)
3330 IF E(R) = 0 THEN RETURN : REM IF NO ENEMY
3340 FOR I = 1 TO 5
3350 IF EB(I) = 0 THEN LET EB(I) = E(R) + 128
3355 IF EB(I) = E(R) + 128 THEN RETURN
3360 NEXT I
3370 RETURN
3500 REM MOVE ENEMIES DOWN
3510 FOR J = 1 TO 15
3520 IF E(J) > 0 THEN LET E(J) = E(J) + 256
3530 NEXT J
3540 RETURN
4000 REM CHECK HITS
4010 FOR I = 1 TO 15
4020 FOR J = 1 TO 5  : REM CHECK ALL BULLETS FOR COLLISION
4030 IF B(J) > 0 AND E(I) > 0 THEN GOSUB 4100 : REM CHECK BULLET HIT
4040 NEXT J
4050 IF E(I) > 5503 THEN GOSUB 6000 : REM ROW 43 UP BECAUSE THE INVADER IS 6 TALL
4060 NEXT I
4070 GOSUB 4200 : REM CHECK BUNKER HITS
4080 GOSUB 4500 : REM CHECK PLAYER HIT
4090 RETURN
4100 REM CHECK BULLET HIT
4110 LET BX = B(J) - 128 * INT(B(J) / 128)
4120 LET BY = INT(B(J) / 128)
4130 LET EX = E(I) - 128 * INT(E(I) / 128)
4140 LET EY = INT(E(I) / 128)
4150 IF BX >= EX AND BX < EX+6 AND BY >= EY AND BY < EY+6 THEN GOSUB 5000
4160 RETURN
4200 REM CHECK BUNKER HITS
4210 FOR I = 1 TO 60
4220 IF BK(I) = 1 THEN GOSUB 4300
4230 NEXT I
4240 RETURN
4300 REM CHECK BULLET HIT BUNKER
4310 LET BN = INT((I-1)/15) +1 :REM STARTING AT 1
4320 LET BP = (I-1) - 15 * INT((I-1) / 15) + 1
4330 IF BP <= 5 THEN LET BX = BP+28+(BN-1)*24
4335 IF BP > 5 AND BP <= 10 THEN LET BX = BP+23+(BN-1)*24
4336 IF BP > 10 THEN LET BX = BP+18+(BN-1)*24
4340 LET BY = 43 - INT((BP-1)/5) : REM TRACKS THE BUNKER ROWS ABOVE
4350 FOR K = 1 TO 5 
4360 IF B(K) > 0 THEN GOSUB 4400  
4370 IF EB(K) > 0 THEN GOSUB 4450  
4380 NEXT K
4390 RETURN
4400 REM PLAYER BULLET HIT BUNKER
4410 LET BBX = B(K) - 128 * INT(B(K) / 128)  
4420 LET BBY = INT(B(K) / 128)  
4430 IF BBX = BX AND BBY = BY THEN LET BK(I) = 0: RESET(BX, BY): RESET(BBX, BBY): LET B(K) = 0
4440 RETURN
4450 REM ENEMY BULLET HIT BUNKER
4460 LET EBX = EB(K) - 128 * INT(EB(K) / 128)  
4470 LET EBY = INT(EB(K) / 128)  
4480 IF EBX = BX AND EBY = BY THEN LET BK(I) = 0: RESET(BX, BY): RESET(EBX, EBY): LET EB(K) = 0
4490 RETURN
4500 REM CHECK PLAYER HIT
4510 FOR I = 1 TO 5
4520 IF EB(I) > 0 THEN GOSUB 4550
4530 NEXT I
4540 RETURN
4550 REM CHECK SINGLE ENEMY BULLET
4560 LET EBX = EB(I) - 128 * INT(EB(I) / 128)
4570 LET EBY = INT(EB(I) / 128)
4580 IF EBY = 46 AND ABS(EBX - S) <= 1 THEN GOSUB 6000 : REM 46 IS THE GUN TIP ROW
4590 RETURN
5000 REM HIT ENEMY
5005 GOSUB 1400 : REM ERASE SPRITE BEFORE CLEARING E(I)
5010 LET SC = SC + 10
5020 LET E(I) = 0
5030 LET B(J) = 0  : REM RESET THE BULLET THAT HIT
5040 REM GOSUB 5100 REM NO DELAYS
5050 GOSUB 5200
5060 RETURN
5100 REM INCREASE SPEED
5110 IF SP > 5 THEN GOSUB 5150
5120 RETURN
5150 REM DECREASE DELAY
5160 LET T = SC / 100
5170 LET T = T - INT(T)
5180 IF T = 0 THEN LET SP = SP - 1
5190 RETURN
5200 REM CHECK IF ALL ENEMIES DESTROYED (FOR uses N: J is bullet loop at 4020)
5210 LET C = 0
5220 FOR N = 1 TO 15
5230 IF E(N) > 0 THEN LET C = C + 1
5240 NEXT N
5250 IF C = 0 THEN GOSUB 7000
5260 RETURN
6000 REM PLAYER INVADED OR HIT (FOR uses N: I is the enemy loop at 4010/4510)
6010 LET LV = LV - 1
6020 IF LV = 0 THEN GOTO 8000
6030 FOR N = 1 TO 15
6040 LET E(N) = 0
6050 NEXT N
6060 FOR N = 1 TO 5
6065 LET B(N) = 0
6070 LET EB(N) = 0
6080 NEXT N
6090 LET S = 120
6100 GOSUB 7000
6110 RETURN
7000 REM RESPAWN ENEMIES (FOR uses N; 1800 uses P/Q so hit-check FOR I/J at 4010/4020 stay intact)
7010 FOR N = 1 TO 15
7020 LET R = INT((N-1)/ 5)
7030 LET C = N - 1 - (R * 5)
7040 LET E(N) = R * 1024 + (C * 24) + 1 + 768 : REM +6 rows (clear SCORE)
7050 NEXT N
7055 CLS
7056 GOSUB 1800 : REM REDRAW BUNKERS FROM BK[]
7057 LET OC = -1: LET OL = -1
7058 LET D = 1 : REM NEW: wave starts marching right (avoids left-edge wrap if D was -1)
7060 RETURN
8000 REM GAME OVER
8010 CLS
8020 PRINT "GAME OVER"
8030 PRINT "FINAL SCORE:"; SC
8040 PRINT "PRESS ANY KEY TO RESTART"
8050 IF PEEK(14400) = 0 THEN GOTO 8050
8060 CLEAR:GOTO 180
