10 REM ============================================================
20 REM JMR LEVEL II SELF-TEST  (TRS-80 Model I Level II style)
30 REM Each page: EXPECTED, RESULT, PASS/FAIL. Press ENTER for next.
40 REM POINT returns -1 when set (Level II boolean true), 0 when clear.
41 REM COLOR/SOUND: use COLOR_T / SOUND_T (kept out so LEVEL2_S fits 24K).
45 REM WHEN TO RUN: after RTL/µcode/PRINT/FOR/SET changes — PYTHON first,
46 REM then F9 FPGA-SIM, then board. Also: pytest tests/ (host unit) +
47 REM tests/programs/*_edges.bas golden outs. ASIC gate before harden.
50 REM ============================================================
60 PP=0:FF=0:OK=0
70 CLS
80 PRINT "JMR LEVEL II SELF-TEST"
90 PRINT "64 cols x 16 rows (Model I glass)."
100 PRINT
110 PRINT "Read EXPECTED, then RESULT, then PASS."
120 PRINT
130 PRINT "Press ENTER to begin..."
140 INPUT Z$
150 REM ----- ARITHMETIC -----
160 CLS
170 PRINT "PAGE: ARITHMETIC + PRECEDENCE"
175 PRINT "NOTE: +numbers print with a leading blank"
180 PRINT "EXPECTED: 7 / 14 / 8 / 32"
190 PRINT "EXPECTED: then PASS"
200 PRINT "---- RESULT ----"
210 A=3+4:PRINT A
220 B=2*7:PRINT B
230 C=2+3*2:PRINT C
240 D=2^5:PRINT D
250 OK=0
260 IF A=7 AND B=14 AND C=8 AND D=32 THEN OK=1
270 GOSUB 9300
280 GOSUB 9000
290 REM ----- RELATIONS / LOGIC -----
300 CLS
310 PRINT "PAGE: RELATIONS AND LOGIC"
320 PRINT "Level II: true=-1  false=0"
330 PRINT "EXPECTED: -1  0  -1"
340 PRINT "EXPECTED: -1  0"
350 PRINT "EXPECTED: then PASS"
360 PRINT "---- RESULT ----"
370 PRINT 5>3;5<3;5=5
380 PRINT (1 AND 1);(1 AND 0)
390 OK=0
400 IF (5>3)=-1 AND (5<3)=0 AND (1 AND 0)=0 THEN OK=1
410 GOSUB 9300
420 GOSUB 9000
430 REM ----- FOR / NEXT -----
440 CLS
450 PRINT "PAGE: FOR / NEXT / STEP"
460 PRINT "EXPECTED: 1 2 3"
470 PRINT "EXPECTED: 10 8 6"
480 PRINT "EXPECTED: then PASS"
490 PRINT "---- RESULT ----"
500 FOR I=1 TO 3:PRINT I;:NEXT:PRINT
510 FOR J=10 TO 6 STEP -2:PRINT J;:NEXT:PRINT
520 OK=0
530 IF I=4 AND J=4 THEN OK=1
540 GOSUB 9300
550 GOSUB 9000
560 REM ----- IF / THEN / ELSE -----
570 CLS
580 PRINT "PAGE: IF / THEN / ELSE"
590 PRINT "EXPECTED: YES"
600 PRINT "EXPECTED: ELSE-OK"
610 PRINT "EXPECTED: then PASS"
620 PRINT "---- RESULT ----"
630 IF 1 THEN PRINT "YES" ELSE PRINT "NO"
640 IF 0 THEN PRINT "BAD" ELSE PRINT "ELSE-OK"
650 T=0:IF 1 THEN T=1 ELSE T=2
660 OK=0
670 IF T=1 THEN OK=1
680 GOSUB 9300
690 GOSUB 9000
700 REM ----- GOSUB / RETURN -----
710 CLS
720 PRINT "PAGE: GOSUB / RETURN"
730 PRINT "EXPECTED: IN-SUB"
740 PRINT "EXPECTED: BACK"
750 PRINT "EXPECTED: then PASS"
760 PRINT "---- RESULT ----"
770 GOSUB 800
780 PRINT "BACK"
790 GOTO 820
800 PRINT "IN-SUB":RETURN
820 OK=1
830 GOSUB 9300
840 GOSUB 9000
