10 REM ============================================================
20 REM JMR LEVEL II SELF-TEST  (TRS-80 Model I Level II style)
30 REM Each page: EXPECTED, RESULT, PASS/FAIL. Press ENTER for next.
40 REM POINT returns -1 when set (Level II boolean true), 0 when clear.
50 REM ============================================================
60 PP=0:FF=0:OK=0
70 CLS
80 PRINT "JMR LEVEL II SELF-TEST"
90 PRINT "64 cols x 16 rows (Model I glass)."
100 PRINT
110 PRINT "Read EXPECTED, then RESULT, then PASS."
120 PRINT
130 PRINT "Press ENTER to begin..."
140 INPUT Z$
150 REM ----- ARITHMETIC -----
160 CLS
170 PRINT "PAGE: ARITHMETIC + PRECEDENCE"
175 PRINT "NOTE: +numbers print with a leading blank"
180 PRINT "EXPECTED: 7 / 14 / 8 / 32"
190 PRINT "EXPECTED: then PASS"
200 PRINT "---- RESULT ----"
210 A=3+4:PRINT A
220 B=2*7:PRINT B
230 C=2+3*2:PRINT C
240 D=2^5:PRINT D
250 OK=0
260 IF A=7 AND B=14 AND C=8 AND D=32 THEN OK=1
270 GOSUB 9300
280 GOSUB 9000
290 REM ----- RELATIONS / LOGIC -----
300 CLS
310 PRINT "PAGE: RELATIONS AND LOGIC"
320 PRINT "Level II: true=-1  false=0"
330 PRINT "EXPECTED: -1  0  -1"
340 PRINT "EXPECTED: -1  0"
350 PRINT "EXPECTED: then PASS"
360 PRINT "---- RESULT ----"
370 PRINT 5>3;5<3;5=5
380 PRINT (1 AND 1);(1 AND 0)
390 OK=0
400 IF (5>3)=-1 AND (5<3)=0 AND (1 AND 0)=0 THEN OK=1
410 GOSUB 9300
420 GOSUB 9000
430 REM ----- FOR / NEXT -----
440 CLS
450 PRINT "PAGE: FOR / NEXT / STEP"
460 PRINT "EXPECTED: 1 2 3"
470 PRINT "EXPECTED: 10 8 6"
480 PRINT "EXPECTED: then PASS"
490 PRINT "---- RESULT ----"
500 FOR I=1 TO 3:PRINT I;:NEXT:PRINT
510 FOR J=10 TO 6 STEP -2:PRINT J;:NEXT:PRINT
520 OK=0
530 IF I=4 AND J=4 THEN OK=1
540 GOSUB 9300
550 GOSUB 9000
560 REM ----- IF / THEN / ELSE -----
570 CLS
580 PRINT "PAGE: IF / THEN / ELSE"
590 PRINT "EXPECTED: YES"
600 PRINT "EXPECTED: ELSE-OK"
610 PRINT "EXPECTED: then PASS"
620 PRINT "---- RESULT ----"
630 IF 1 THEN PRINT "YES" ELSE PRINT "NO"
640 IF 0 THEN PRINT "BAD" ELSE PRINT "ELSE-OK"
650 T=0:IF 1 THEN T=1 ELSE T=2
660 OK=0
670 IF T=1 THEN OK=1
680 GOSUB 9300
690 GOSUB 9000
700 REM ----- GOSUB / RETURN -----
710 CLS
720 PRINT "PAGE: GOSUB / RETURN"
730 PRINT "EXPECTED: IN-SUB"
740 PRINT "EXPECTED: BACK"
750 PRINT "EXPECTED: then PASS"
760 PRINT "---- RESULT ----"
770 GOSUB 800
780 PRINT "BACK"
790 GOTO 820
800 PRINT "IN-SUB":RETURN
820 OK=1
830 GOSUB 9300
840 GOSUB 9000
850 REM ----- ON GOTO / ON GOSUB -----
860 CLS
870 PRINT "PAGE: ON GOTO / ON GOSUB"
880 PRINT "EXPECTED: TWO"
890 PRINT "EXPECTED: G2"
900 PRINT "EXPECTED: then PASS"
910 PRINT "---- RESULT ----"
920 ON 2 GOTO 940,950,960
930 PRINT "BAD-ON":GOTO 970
940 PRINT "ONE":GOTO 970
950 PRINT "TWO":GOTO 970
960 PRINT "THREE"
970 ON 2 GOSUB 990,1000
980 GOTO 1010
990 PRINT "G1":RETURN
1000 PRINT "G2":RETURN
1010 OK=1
1020 GOSUB 9300
1030 GOSUB 9000
1040 REM ----- DATA / READ / RESTORE -----
1050 CLS
1060 PRINT "PAGE: DATA / READ / RESTORE"
1070 PRINT "EXPECTED: 11  22"
1080 PRINT "EXPECTED: 11"
1090 PRINT "EXPECTED: then PASS"
1100 PRINT "---- RESULT ----"
1110 DATA 11,22,33
1120 READ A,B:PRINT A;B
1130 RESTORE
1140 READ C:PRINT C
1150 OK=0
1160 IF A=11 AND B=22 AND C=11 THEN OK=1
1170 GOSUB 9300
1180 GOSUB 9000
1190 REM ----- STRINGS -----
1200 CLS
1210 PRINT "PAGE: STRING FUNCTIONS"
1220 PRINT "EXPECTED: 5 / HE / LO / ELL"
1230 PRINT "EXPECTED: 65  A  12 / **"
1240 PRINT "EXPECTED: then PASS"
1250 PRINT "---- RESULT ----"
1260 S$="HELLO"
1270 PRINT LEN(S$)
1280 PRINT LEFT$(S$,2)
1290 PRINT RIGHT$(S$,2)
1300 PRINT MID$(S$,2,3)
1310 PRINT ASC("A");CHR$(65);VAL("12")
1320 PRINT STRING$(2,"*")
1330 OK=0
1340 IF LEN(S$)<>5 THEN 1380
1350 IF LEFT$(S$,2)<>"HE" THEN 1380
1360 IF RIGHT$(S$,2)<>"LO" THEN 1380
1370 IF MID$(S$,2,3)="ELL" THEN OK=1
1380 GOSUB 9300
1390 GOSUB 9000
1400 REM ----- ARRAYS -----
1410 CLS
1420 PRINT "PAGE: ARRAYS (DIM)"
1430 PRINT "EXPECTED: 0  4  16"
1440 PRINT "EXPECTED: 7"
1450 PRINT "EXPECTED: then PASS"
1460 PRINT "---- RESULT ----"
1470 DIM A(4)
1480 FOR I=0 TO 4:A(I)=I*I:NEXT
1490 PRINT A(0);A(2);A(4)
1500 DIM C(1,2):C(1,2)=7:PRINT C(1,2)
1510 OK=0
1520 IF A(0)=0 AND A(2)=4 AND A(4)=16 AND C(1,2)=7 THEN OK=1
1530 GOSUB 9300
1540 GOSUB 9000
1550 REM ----- NUMERIC FNS -----
1560 CLS
1570 PRINT "PAGE: INT FIX SGN ABS SQR"
1580 PRINT "EXPECTED: 2  2  -1  7  4"
1590 PRINT "EXPECTED: then PASS"
1600 PRINT "---- RESULT ----"
1610 PRINT INT(2.9);FIX(2.9);SGN(-3);ABS(-7);SQR(16)
1620 OK=0
1630 IF INT(2.9)<>2 THEN 1680
1640 IF FIX(2.9)<>2 THEN 1680
1650 IF SGN(-3)<>-1 THEN 1680
1660 IF ABS(-7)<>7 THEN 1680
1670 IF SQR(16)=4 THEN OK=1
1680 GOSUB 9300
1690 GOSUB 9000
1700 REM ----- TRIG -----
1710 CLS
1720 PRINT "PAGE: SIN COS ATN LOG EXP"
1730 PRINT "EXPECTED: 0  1  0"
1740 PRINT "EXPECTED: 0  1"
1750 PRINT "EXPECTED: then PASS"
1760 PRINT "---- RESULT ----"
1770 PRINT SIN(0);COS(0);ATN(0)
1780 PRINT LOG(1);EXP(0)
1790 OK=0
1800 IF SIN(0)<>0 THEN 1850
1810 IF COS(0)<>1 THEN 1850
1820 IF ATN(0)<>0 THEN 1850
1830 IF LOG(1)<>0 THEN 1850
1840 IF EXP(0)=1 THEN OK=1
1850 GOSUB 9300
1860 GOSUB 9000
1870 REM ----- DEF FN -----
1880 CLS
1890 PRINT "PAGE: DEF FN"
1900 PRINT "EXPECTED: 9"
1910 PRINT "EXPECTED: then PASS"
1920 PRINT "---- RESULT ----"
1930 DEF FNF(X)=X*X
1940 PRINT FNF(3)
1950 OK=0
1960 IF FNF(3)=9 THEN OK=1
1970 GOSUB 9300
1980 GOSUB 9000
1990 REM ----- TAB / USING -----
2000 CLS
2010 PRINT "PAGE: PRINT TAB AND USING"
2020 PRINT "EXPECTED: T near column 5"
2030 PRINT "EXPECTED: [sp]42  (USING ### left-pad)"
2040 PRINT "EXPECTED: -1.50  (USING ##.##; minus in field)"
2050 PRINT "EXPECTED: then PASS"
2060 PRINT "---- RESULT ----"
2070 PRINT TAB(5);"T"
2080 PRINT USING "###";42
2090 PRINT USING "##.##";-1.5
2100 OK=1
2110 GOSUB 9300
2120 GOSUB 9000
2130 REM ----- SET / RESET / POINT -----
2140 CLS
2150 PRINT "PAGE: SET / RESET / POINT"
2160 PRINT "EXPECTED: -1  (neg: minus, no leading blank)"
2170 PRINT "EXPECTED: [sp]0  (pos: Level II leading blank)"
2180 PRINT "EXPECTED: then PASS"
2190 PRINT "---- RESULT ----"
2200 SET(10,10)
2210 P1=POINT(10,10):PRINT P1
2220 RESET(10,10)
2230 P0=POINT(10,10):PRINT P0
2240 OK=0
2250 IF P1=-1 AND P0=0 THEN OK=1
2260 GOSUB 9300
2270 GOSUB 9000
2280 REM ----- PEEK / POKE -----
2290 CLS
2300 PRINT "PAGE: POKE / PEEK VIDEO RAM"
2310 PRINT "TRS VRAM base 15360."
2320 PRINT "EXPECTED: [sp]65[sp]A  (+num leading blank)"
2330 PRINT "EXPECTED: then PASS"
2340 PRINT "---- RESULT ----"
2350 POKE 15360,65
2360 PRINT PEEK(15360);CHR$(PEEK(15360))
2370 OK=0
2380 IF PEEK(15360)=65 THEN OK=1
2390 GOSUB 9300
2400 GOSUB 9000
2410 REM ----- ON ERROR -----
2420 CLS
2430 PRINT "PAGE: ON ERROR GOTO / ERR"
2440 PRINT "EXPECTED: CAUGHT"
2450 PRINT "EXPECTED: ERR=[sp]n  (string ERR= then +num blank)"
2460 PRINT "EXPECTED: AFTER"
2470 PRINT "EXPECTED: then PASS"
2480 PRINT "---- RESULT ----"
2490 ER=0
2500 ON ERROR GOTO 2560
2510 ERROR 4
2520 PRINT "AFTER"
2530 OK=0
2540 IF ER>0 THEN OK=1
2550 GOTO 2590
2560 PRINT "CAUGHT"
2570 PRINT "ERR=";ERR
2580 ER=ERR:RESUME 2520
2590 ON ERROR GOTO 0
2600 GOSUB 9300
2610 GOSUB 9000
2620 REM ----- MEM / FRE / RND -----
2630 REM Level II: RND(0)=fraction (0,1); RND(n)=integer 1..n (so RND(1) is always 1)
2640 CLS
2650 PRINT "PAGE: MEM FRE RND"
2660 PRINT "NOTE: each PRINT number has a leading blank (+)"
2670 PRINT "EXPECTED: MEM > 0"
2680 PRINT "EXPECTED: FRE number"
2690 PRINT "EXPECTED: RND(0) fraction"
2700 PRINT "EXPECTED: RND(6) in 1..6"
2710 PRINT "EXPECTED: then PASS"
2720 PRINT "---- RESULT ----"
2730 PRINT MEM
2740 PRINT FRE("")
2750 R0=RND(0):PRINT R0
2760 R6=RND(6):PRINT R6
2770 OK=0
2780 IF MEM>0 AND R0>0 AND R0<1 AND R6>=1 AND R6<=6 THEN OK=1
2790 GOSUB 9300
2795 GOSUB 9000
2800 REM ----- FILE I/O -----
2810 CLS
2820 PRINT "PAGE: OPEN / PRINT# / LINE INPUT#"
2830 PRINT "EXPECTED: LINE1"
2840 PRINT "EXPECTED: then PASS"
2850 PRINT "---- RESULT ----"
2860 ON ERROR GOTO 2960
2870 OPEN "O",1,"L2TEST.DAT"
2880 PRINT#1,"LINE1"
2890 CLOSE 1
2900 OPEN "I",1,"L2TEST.DAT"
2910 LINE INPUT#1,L$
2920 CLOSE 1
2930 PRINT L$
2940 OK=0
2950 IF L$="LINE1" THEN OK=1
2955 GOTO 2980
2960 PRINT "(file I/O skipped / error)"
2970 OK=0:RESUME 2980
2980 ON ERROR GOTO 0
2990 GOSUB 9300
3000 GOSUB 9000
3010 REM ----- DEFINT + CLEAR keeps DEF (Level II) -----
3020 CLS
3030 PRINT "PAGE: DEFINT / CLEAR KEEPS DEF"
3040 PRINT "EXPECTED: 2   (DEFINT trunc)"
3050 PRINT "EXPECTED: 1   (CLEAR keeps DEFINT)"
3060 PRINT "EXPECTED: then PASS"
3070 PRINT "---- RESULT ----"
3080 DEFINT Q
3090 Q=2.9:PRINT Q
3100 REM CLEAR wipes vars - stash PP/FF via integer POKE into VRAM
3110 PP%=PP:FF%=FF:POKE 16000,PP%:POKE 16001,FF%
3120 CLEAR
3130 PP=PEEK(16000):FF=PEEK(16001)
3140 Q=1.7:PRINT Q
3150 OK=0
3160 IF Q=1 THEN OK=1
3170 GOSUB 9300
3180 GOSUB 9000
3190 REM ----- CSAVE alias (same token as SAVE; no ?SN) -----
3200 CLS
3210 PRINT "PAGE: CSAVE ALIAS (SMOKE)"
3220 PRINT "EXPECTED: CSAVE ok (or PASS)"
3230 PRINT "EXPECTED: then PASS"
3240 PRINT "---- RESULT ----"
3250 ON ERROR GOTO 3300
3260 CSAVE "L2ALIAST"
3270 PRINT "CSAVE ok"
3280 OK=1
3290 GOTO 3320
3300 PRINT "CSAVE err";ERR
3310 OK=0:RESUME 3320
3320 ON ERROR GOTO 0
3330 GOSUB 9300
3340 GOSUB 9000
3500 REM ----- ADDED: MOD -----
3510 CLS
3520 PRINT "PAGE: MOD"
3530 PRINT "EXPECTED: 1  0  2"
3540 PRINT "EXPECTED: then PASS"
3550 PRINT "---- RESULT ----"
3560 PRINT 10 MOD 3;8 MOD 4;5 MOD 3
3570 OK=0
3580 IF (10 MOD 3)=1 AND (8 MOD 4)=0 AND (5 MOD 3)=2 THEN OK=1
3590 GOSUB 9300
3600 GOSUB 9000
3610 REM ----- ADDED: NESTED FOR -----
3620 CLS
3630 PRINT "PAGE: NESTED FOR"
3640 PRINT "EXPECTED: 11 12 21 22"
3650 PRINT "EXPECTED: then PASS"
3660 PRINT "---- RESULT ----"
3670 S=0
3680 FOR X=1 TO 2:FOR Y=1 TO 2
3690 PRINT 10*X+Y;
3700 S=S+10*X+Y
3710 NEXT Y:NEXT X:PRINT
3720 OK=0
3730 IF S=66 THEN OK=1
3740 GOSUB 9300
3750 GOSUB 9000
3760 REM ----- ADDED: STRING CONCAT -----
3770 CLS
3780 PRINT "PAGE: STRING CONCAT"
3790 PRINT "EXPECTED: HILO"
3800 PRINT "EXPECTED: then PASS"
3810 PRINT "---- RESULT ----"
3820 PRINT "HI"+"LO"
3830 OK=0
3840 IF "HI"+"LO"="HILO" THEN OK=1
3850 GOSUB 9300
3860 GOSUB 9000
3870 REM ----- ADDED: INSTR / STR$ -----
3880 CLS
3890 PRINT "PAGE: INSTR / STR$"
3900 PRINT "EXPECTED: 2  0"
3910 PRINT "EXPECTED: STR$ has leading blank for +"
3920 PRINT "EXPECTED: then PASS"
3930 PRINT "---- RESULT ----"
3940 PRINT INSTR("HELLO","E");INSTR("HELLO","Z")
3950 T$=STR$(7):PRINT T$
3960 OK=0
3970 IF INSTR("HELLO","E")<>2 THEN 4010
3980 IF INSTR("HELLO","Z")<>0 THEN 4010
3990 IF LEFT$(T$,1)=" " AND VAL(T$)=7 THEN OK=1
4010 GOSUB 9300
4020 GOSUB 9000
4030 REM ----- ADDED: PRINT@ -----
4040 CLS
4050 PRINT "PAGE: PRINT@"
4060 PRINT "EXPECTED: @ at upper-left (PEEK VRAM)"
4070 PRINT "EXPECTED: then PASS"
4080 PRINT "---- RESULT ----"
4090 PRINT@0,"@"
4100 PRINT@64,"ROW1"
4110 OK=0
4120 IF PEEK(15360)=ASC("@") THEN OK=1
4130 GOSUB 9300
4140 GOSUB 9000
4150 REM ----- ADDED: RND(1)=1 -----
4160 CLS
4170 PRINT "PAGE: RND(1) LEVEL II"
4180 PRINT "EXPECTED: RND(1)=1"
4190 PRINT "EXPECTED: then PASS"
4200 PRINT "---- RESULT ----"
4210 R1=RND(1):PRINT R1
4220 OK=0
4230 IF R1=1 THEN OK=1
4240 GOSUB 9300
4250 GOSUB 9000
4260 REM ----- ADDED: DEFINT LETTER RANGE -----
4270 CLS
4280 PRINT "PAGE: DEFINT LETTER RANGE"
4290 PRINT "EXPECTED: 3  4  5  (I-K trunc)"
4300 PRINT "EXPECTED: 6.5 kept as single (H)"
4310 PRINT "EXPECTED: then PASS"
4320 PRINT "---- RESULT ----"
4330 DEFINT I-K
4340 I=3.9:J=4.2:K=5.8:H=6.5
4350 PRINT I;J;K
4360 PRINT H
4370 OK=0
4380 IF I<>3 THEN 4420
4390 IF J<>4 THEN 4420
4400 IF K<>5 THEN 4420
4410 IF H=6.5 THEN OK=1
4420 GOSUB 9300
4430 GOSUB 9000
4440 REM ----- ADDED: A% AND A! DISTINCT -----
4450 CLS
4460 PRINT "PAGE: A% AND A! DISTINCT"
4470 PRINT "EXPECTED: 3  4"
4480 PRINT "EXPECTED: then PASS"
4490 PRINT "---- RESULT ----"
4500 A%=3:A!=4
4510 PRINT A%;A!
4520 OK=0
4530 IF A%=3 AND A!=4 THEN OK=1
4540 GOSUB 9300
4550 GOSUB 9000
4560 REM ----- ADDED: DEFSTR -----
4570 CLS
4580 PRINT "PAGE: DEFSTR"
4590 PRINT "EXPECTED: HI"
4600 PRINT "EXPECTED: then PASS"
4610 PRINT "---- RESULT ----"
4620 DEFSTR W
4630 W="HI":PRINT W
4640 OK=0
4650 IF W="HI" THEN OK=1
4660 GOSUB 9300
4670 GOSUB 9000
4680 REM ----- ADDED: DEFINT A SHARES A% -----
4690 CLS
4700 PRINT "PAGE: DEFINT A SHARES A%"
4710 PRINT "EXPECTED: 5  5  (bare A and A% same slot)"
4720 PRINT "EXPECTED: then PASS"
4730 PRINT "---- RESULT ----"
4740 DEFINT A
4750 A=5.9:PRINT A;A%
4760 OK=0
4770 IF A=5 AND A%=5 THEN OK=1
4780 GOSUB 9300
4790 GOSUB 9000
5000 REM ----- SUMMARY -----
5010 CLS
5020 PRINT "======== SELF-TEST SUMMARY ========"
5030 PRINT "PASS pages:";PP
5040 PRINT "FAIL pages:";FF
5050 PRINT
5060 IF FF=0 THEN PRINT "ALL CHECKED PAGES PASSED." ELSE PRINT "SOME PAGES FAILED."
5070 PRINT
5080 PRINT "END OF TEST."
5090 END
9000 REM pause
9010 PRINT
9020 INPUT "PRESS ENTER FOR NEXT PAGE";Z$
9030 RETURN
9300 REM score OK
9310 IF OK=1 THEN 9340
9320 PRINT "FAIL"
9330 FF=FF+1:RETURN
9340 PRINT "PASS"
9350 PP=PP+1:RETURN
